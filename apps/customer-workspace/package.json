{
  "name": "@acdl/customer-workspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run prepare:runtime && npm run style:check && next dev -p 3000",
    "build": "npm run prepare:runtime && npm run style:check && next build && npm run verify:published",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "style:check": "node scripts/check-style.mjs",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "prepare:runtime": "node scripts/build-shared-runtime.mjs",
    "verify:published": "node --experimental-strip-types scripts/check-published.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.111.0",
    "@fontsource/noto-sans-kr": "5.3.1",
    "mammoth": "1.12.0",
    "next": "15.5.29",
    "pdfjs-dist": "5.4.624",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xlsx": "0.18.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2"
  }
}
