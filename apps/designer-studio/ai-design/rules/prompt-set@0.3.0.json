{
  "id": "school-calendar-prompt",
  "version": "0.3.0",
  "experiment": "coherent-design-set-monthly-variation-v1",
  "purpose": "표지·연력·월력·월력 뒷면·뒷표지를 하나의 디자인 언어로 연결하면서 12개월의 색과 일러스트를 개별 변주한다.",
  "designSet": {
    "keepConsistent": ["shape-family", "line-weight", "texture", "typographic-mood", "photo-frame-language", "base-palette"],
    "vary": ["month-accent-color", "background-tone", "seasonal-motif", "month-back-independent-illustration"],
    "seasonFlow": {"spring": [3, 4, 5], "summer": [6, 7, 8], "autumn": [9, 10, 11], "winter": [12, 1, 2]},
    "variationStrength": "recognizably-related-not-identical"
  },
  "assets": {
    "cover": {"count": 1, "reserve": ["school-photo", "year", "school-name", "school-logo", "school-contact"]},
    "annual": {"count": 1, "reserve": ["year", "annual-calendar"]},
    "month": {"count": 12, "perMonth": ["background-tone", "month-accent", "edge-decoration"], "reserve": ["month", "weekday", "date", "school-event", "mini-calendar"]},
    "monthBack": {"count": 12, "perMonth": ["independent-illustration", "supporting-decoration"], "reserve": ["planner", "checklist", "memo", "mini-calendar", "band-calendar"]},
    "backCover": {"count": 1, "reserve": ["school-name", "address", "contact", "school-logo"]}
  },
  "forbid": ["letters", "numbers", "dates", "calendar-grid", "school-name", "address", "contact", "logo", "emblem", "watermark", "fake-text"],
  "generation": {"draftQuality": "low", "reviewQuality": "medium", "applyOnlyWhenRoleResultReady": true},
  "print": {"sourceColorSpace": "RGB", "size": "1536x1024", "safeAreaRequired": true, "bleedAware": true}
}
