{
  "id": "calendar-page-rules",
  "version": "0.7.0",
  "promptSet": "school-calendar-design@0.8.0",
  "generationContext": "ai-generation-context.v1@0.1.0",
  "roleSelection": "calendar-type-policy-and-existing-pages",
  "monthlyExpansion": "enabled-monthly-roles-only",
  "roles": {
    "cover": {"policy": "cover", "editable": ["year", "title", "school-photo", "school-logo", "school-information"]},
    "annual": {"policy": "annualSingle", "editable": ["year", "annual-calendar", "holiday-information"]},
    "school-symbols": {"policy": "pageRules.school-symbols", "editable": ["school-logo", "school-name", "motto", "school-song", "school-tree", "school-flower"]},
    "month": {"policy": "monthlyFront", "repeatBy": "month", "editable": ["month", "year", "weekday", "date-grid", "school-event", "mini-calendar", "school-logo", "slogan"]},
    "month-back": {"policy": "monthlyBack", "repeatBy": "month", "editable": ["image-frame", "current-calendar", "adjacent-mini-calendar", "planner", "memo", "date-strip"], "designerFinishesComposition": true},
    "back-cover": {"policy": "backCover", "editable": ["school-name", "school-logo", "address", "phone", "fax", "website"]}
  },
  "forbid": ["unsupported-page-role-generation", "rasterized-editable-content", "invented-school-identity", "decoration-over-protected-region"]
}
