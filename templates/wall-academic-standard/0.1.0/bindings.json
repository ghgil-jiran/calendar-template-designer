{
  "contractVersion": "1.1",
  "templateId": "wall-academic-standard",
  "templateVersion": "0.1.0",
  "bindings": [
    { "path": "school.name", "required": true, "status": "current", "missing": "error" },
    { "path": "school.slogan", "required": false, "status": "current", "missing": "empty" },
    { "path": "school.profile.building", "required": false, "status": "current", "missing": "empty" },
    { "path": "calendar.year", "required": true, "status": "current", "missing": "error" },
    { "path": "calendar.startMonth", "required": true, "status": "current", "missing": "default-3" },
    { "path": "calendar.events", "required": false, "status": "current", "missing": "empty-list" },
    { "path": "monthlyImages", "required": false, "status": "current", "missing": "school.profile.building" }
  ]
}
