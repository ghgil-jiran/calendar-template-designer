{
  "schemaVersion": "template.v2-draft",
  "templateId": "wall-academic-standard",
  "version": "0.2.0",
  "kind": "integration-template-draft",
  "extractionStatus": "package-contract-review",
  "source": {
    "application": "apps/designer-studio/index.html",
    "canonicalPresetId": "tpl-2027-wall",
    "selectionRule": "학교 이미지형 벽걸이 디자인 검토본의 앞표지·앞간지·12개월 월력·뒷표지 단면 구조를 공통 Runtime 두 번째 유형 검증 대상으로 선택"
  },
  "sampleAssets": {
    "schoolPhoto": {
      "ref": "url",
      "src": "data:image/svg+xml;base64,",
      "kind": "template-sample",
      "replaceable": true
    }
  },
  "calendar": {
    "defaultRows": 6,
    "supportedRows": [
      5,
      6
    ],
    "defaultWeekStart": "sunday",
    "monthCount": 12
  },
  "pageSequence": [
    {
      "page": 1,
      "role": "cover-front"
    },
    {
      "page": 2,
      "role": "school-symbols"
    },
    {
      "pages": "3..14",
      "repeat": 12,
      "role": "monthly-calendar",
      "monthOffset": "0..11"
    },
    {
      "page": 15,
      "role": "back-contact"
    }
  ],
