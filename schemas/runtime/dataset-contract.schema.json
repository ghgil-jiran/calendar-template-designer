{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calendar-platform.example/schemas/runtime/dataset-contract.schema.json",
  "title": "Dataset Contract v1.0",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "locale": { "type": "string" },
    "timezone": { "type": "string" },
    "school": { "type": "object" },
    "calendar": { "type": "object" },
    "monthlyImages": { "oneOf": [{"type":"object"},{"type":"array"}] },
    "monthlyQuotes": {
      "type": "object",
      "patternProperties": {
        "^[0-9]{4}-(0[1-9]|1[0-2])$": {
          "type": "object",
          "required": ["title", "quoteKo"],
          "properties": {
            "title": { "type": "string" },
            "quoteKo": { "type": "string" },
            "quoteEn": { "type": "string" },
            "source": { "type": "string" },
            "sourceStatus": { "enum": ["verified", "unverified", "original", "edited"] },
            "translationType": { "enum": ["original", "official", "editorial"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "variables": { "type": "object" }
  },
  "additionalProperties": true
}
