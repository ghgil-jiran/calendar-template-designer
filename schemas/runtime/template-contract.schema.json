{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calendar-platform.example/schemas/runtime/template-contract.schema.json",
  "title": "Template Contract v1.0",
  "type": "object",
  "required": ["schemaVersion", "id", "revision", "pages"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "pages": { "type": "array", "items": { "$ref": "#/$defs/page" } }
  },
  "$defs": {
    "size": { "type": "object", "required": ["width", "height", "unit"], "properties": { "width": {"type":"number","exclusiveMinimum":0}, "height":{"type":"number","exclusiveMinimum":0}, "unit":{"enum":["mm","pt","px"]} } },
    "frame": { "type": "object", "required": ["x","y","width","height"], "properties": { "x":{"type":"number"}, "y":{"type":"number"}, "width":{"type":"number","minimum":0}, "height":{"type":"number","minimum":0} } },
    "object": { "type": "object", "required": ["id","type","frame"], "properties": { "id":{"type":"string"}, "type":{"type":"string"}, "frame":{"$ref":"#/$defs/frame"}, "binding":{"type":"string"}, "value":{}, "style":{"type":"object"}, "children":{"type":"array","items":{"$ref":"#/$defs/object"}} } },
    "page": { "type":"object", "required":["id","role","size","objects"], "properties": { "id":{"type":"string"}, "role":{"type":"string"}, "size":{"$ref":"#/$defs/size"}, "objects":{"type":"array","items":{"$ref":"#/$defs/object"}} } }
  }
}
