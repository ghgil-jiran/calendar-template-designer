{
  "name": "calendar-template-designer",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test:runtime": "cd packages/template-runtime && npm test",
    "test:integration": "cd packages/designer-runtime-integration && npm test",
    "check:studio": "node tools/check-studio.mjs",
    "test:packages": "npm run test:runtime && npm run test:integration && npm run test:sprint1",
    "test:studio": "node --test tests/*.test.mjs && npm run test:sprint2-product && npm run check:studio",
    "verify": "npm run test:packages && npm run test:studio",
    "style:check": "node scripts/check-project-style.mjs",
    "build": "npm run style:check && npm run verify",
    "cache:clean": "node scripts/clean-next-cache.mjs",
    "schoolp:update:check": "node scripts/schoolp-update-check.mjs",
    "schoolp:issue:check": "node scripts/schoolp-issue-check.mjs",
    "schoolp:update:verify": "npm run style:check && npm run build",
    "test:contracts": "cd packages/contracts && npm test",
    "test:editor-core": "cd packages/editor-core && npm test",
    "test:calendar-domain": "cd packages/calendar-domain && npm test",
    "test:renderer-core": "cd packages/renderer-core && npm test",
    "test:sprint1": "npm run test:contracts && npm run test:editor-core && npm run test:calendar-domain && npm run test:renderer-core",
    "demo:sprint2": "npm run verify && node tools/serve-designer-studio.mjs",
    "dev": "node tools/serve-designer-studio.mjs",
    "test:sprint2-product": "node tools/check-sprint2-product.mjs",
    "test:wizard": "node --test tests/wizard-flow.test.mjs",
    "build:user-service-runtime": "npm run test:integration && node tools/build-user-service-runtime-package.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
